# DeskWeave local development environment template.
# Copy to `.env` and adjust. NEVER commit real secrets.

# --- Python runtime service ---
# Host/port for the local control API (bound to loopback only).
DESKWEAVE_HOST=127.0.0.1
DESKWEAVE_PORT=8787
# Shared token required by the local control API. Leave empty to auto-generate
# on startup (written to the runtime state file). Provide a value only locally.
DESKWEAVE_TOKEN=
# Directory used for the SQLite database and runtime state files.
DESKWEAVE_DATA_DIR=.deskweave
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
DESKWEAVE_LOG_LEVEL=INFO

# --- Desktop app (Tauri) ---
# URL of the local runtime control API used by the desktop shell.
VITE_DESKWEAVE_RUNTIME_URL=http://127.0.0.1:8787
# Optional: absolute path to the Python interpreter used to spawn the sidecar.
DESKWEAVE_PYTHON=
